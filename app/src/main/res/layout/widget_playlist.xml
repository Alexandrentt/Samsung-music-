<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playlist_widget_root"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/playlist_widget_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_playlist"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/playlist_widget_title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Mi Playlist"/>

        <ImageButton
            android:id="@+id/playlist_widget_btn_play_all"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_widget_play"
            android:scaleType="centerInside"
            android:contentDescription="Reproducir todo"/>
    </LinearLayout>

    <TextView
        android:id="@+id/playlist_widget_subtitle"
        android:textSize="11sp"
        android:textColor="#b0bec5"
        android:maxLines="1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Lista de reproducción"/>

    <ListView
        android:id="@+id/playlist_widget_list"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"/>
</LinearLayout>
