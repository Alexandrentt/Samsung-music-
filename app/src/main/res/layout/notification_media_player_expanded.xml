<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="128dp"
    android:background="@drawable/bg_notif_card">

    <!-- NOTA RemoteViews: solo vistas de la lista blanca. Un <View> genérico
         provocaba BadForegroundServiceNotificationException en Android 14. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Portada cuadrada grande -->
        <ImageView
            android:id="@+id/notif_cover"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:contentDescription="Portada"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_notif_gradient" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Fila superior: título + cerrar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/notif_song_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Música"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/notif_song_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Reproducción activa"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/notif_btn_close"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_notif_close_circle"
                    android:contentDescription="Cerrar reproducción"
                    android:padding="5dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_notif_close" />
            </LinearLayout>

            <!-- Barra de progreso -->
            <ProgressBar
                android:id="@+id/notif_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="10dp"
                android:max="1000"
                android:progress="350"
                android:progressDrawable="@drawable/progress_notif_drawable" />

            <!-- Fila inferior: prev | play | next | shuffle | favorito -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/notif_btn_prev"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Anterior"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_notif_prev" />

                <ImageButton
                    android:id="@+id/notif_btn_play_pause"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@drawable/bg_notif_play_squircle"
                    android:contentDescription="Reproducir o pausar"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_notif_pause_dark" />

                <ImageButton
                    android:id="@+id/notif_btn_next"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Siguiente"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_notif_next" />

                <ImageButton
                    android:id="@+id/notif_btn_shuffle"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Aleatorio"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_notif_shuffle" />

                <ImageButton
                    android:id="@+id/notif_btn_favorite"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Favorito"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_notif_thumb_up" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
