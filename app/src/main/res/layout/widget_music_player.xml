<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/widget_root"
    android:background="@drawable/widget_bg"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_cover_image"
        android:background="#2c3440"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_launcher_foreground"
        android:scaleType="centerCrop"
        android:contentDescription="Portada"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/widget_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/widget_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Música"
            android:maxLines="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#b0bec5"
            android:ellipsize="end"
            android:id="@+id/widget_song_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Toca para reproducir"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_widget_prev"
            android:scaleType="centerInside"
            android:contentDescription="Anterior"/>
        <ImageButton
            android:id="@+id/widget_btn_play_pause"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_widget_play"
            android:scaleType="centerInside"
            android:contentDescription="Reproducir / Pausar"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <ImageButton
            android:id="@+id/widget_btn_next"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_widget_next"
            android:scaleType="centerInside"
            android:contentDescription="Siguiente"/>
    </LinearLayout>
</LinearLayout>
